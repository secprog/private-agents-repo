# -----------------------------------------------------------------------------
# agents/rag strict environment configuration
# -----------------------------------------------------------------------------

# Required model + database
LLM_MODEL=provider/chat-model
DATABASE_URL=postgresql://admin:admin123@localhost:5432/agent_platform

# Required planner knobs
THINKING_BUDGET=1024
INCLUDE_THOUGHTS=true

# Required Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=secdev

# Required runtime limits/retries
EMBEDDING_TIMEOUT=30
NEO4J_TIMEOUT=15
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
EMBEDDING_MAX_RETRIES=3
NEO4J_MAX_RETRIES=3
MAX_QUERY_LENGTH=10000
LLM_CONCURRENCY=10
EMBEDDING_INPUT_MAX_CHARS=8000
RRF_K=40
RRF_SCORE_ALPHA=0.25
LOW_CONFIDENCE_SCORE_GAP=0.004
LOW_CONFIDENCE_THRESHOLD=0.62
CROSS_ENCODER_MAX_DOCS=12
CROSS_ENCODER_CONCURRENCY=4
MAX_CONTEXT_TOKENS=12000
CONTEXT_MIN_SOURCES=2
CONTEXT_CANDIDATE_MULTIPLIER=4
MIN_CITATIONS=2
LUCENE_ESCAPE_ENABLED=true
ENTITY_FUZZY_FALLBACK=true
ENTITY_FUZZY_EDIT_DISTANCE=1
CITATION_REPAIR_ENABLED=true
DEBUG_RETRIEVAL_METRICS=false
# HF tokenizer uses LLM_MODEL (same model var as LiteLLM)
TOKENIZER_HF_USE_FAST=true
TOKENIZER_HF_TRUST_REMOTE_CODE=false
TOKENIZER_HF_REVISION=

# Embedding model (required)
LITELLM_EMBEDDING_MODEL=provider/embedding-model

# Optional LiteLLM provider credentials
# LITELLM_API_KEY=
# LITELLM_API_BASE=
# LITELLM_API_VERSION=

# Multimodal payload retrieval (LiteLLM + Voyage multimodal)
MULTIMODAL_EMBEDDING_MODEL=voyage/voyage-multimodal-3.5
MULTIMODAL_EMBEDDING_DIM=1024
MULTIMODAL_EMBEDDING_TIMEOUT=120
MULTIMODAL_L2_NORMALIZE=true
MULTIMODAL_TEXT_INPUT_TYPE=query
MULTIMODAL_IMAGE_INPUT_TYPE=document
MULTIMODAL_VIDEO_INPUT_TYPE=document
# VOYAGE_API_KEY=
# VOYAGE_AI_API_KEY=

# Payload multimodal retrieval fan-out
TOP_K_IMAGE_VEC_PAYLOADS=5
TOP_K_AUDIO_VEC_PAYLOADS=5
TOP_K_AUDIO_LEX_PAYLOADS=5
TOP_K_VIDEO_VEC_PAYLOADS=5
AUDIO_EMBEDDING_STRATEGY=transcript_text
VIDEO_EXTENSIONS=.mp4,.webm,.mpeg,.mpg
